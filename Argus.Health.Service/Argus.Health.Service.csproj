<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>1.0.0</Version>
        <LangVersion>14.0</LangVersion>
        <Copyright>Copyright © Sam Gerené</Copyright>
        <AssemblyTitle>Argus.Health.Service</AssemblyTitle>
        <Title>Argus Health</Title>
        <Description>A background service that queries health endpoints.</Description>
        <RequireLicenseAcceptance>true</RequireLicenseAcceptance>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <IncludeSource>true</IncludeSource>
        <IncludeSymbols>true</IncludeSymbols>
        <RepositoryUrl>https://github.com/samgerene/Argus.Health.git</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <NeutralLanguage>en-US</NeutralLanguage>
        <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
        <Authors>Sam Gerené</Authors>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>argus-health.png</PackageIcon>
        <PackageTags>Health status</PackageTags>
        <PackageReleaseNotes>
            [Initial] Version
        </PackageReleaseNotes>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <UserSecretsId>dotnet-Argus.Service-5413f8d8-9f49-4836-9348-d095be6fe6ee</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\argus-health-ico.png" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentResults" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
        <PackageReference Include="Microsoft.Extensions.Http.Polly" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Extensions.Hosting" />

        <PackageReference Include="Serilog.Settings.Configuration" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.File" />
    </ItemGroup>

    <ItemGroup>

        <ProjectReference Include="..\Argus.Health.Common\Argus.Health.Common.csproj" />

        <!--
        <ProjectReference Include="..\..\ArgusTransfer\ArgusTransfer\ArgusTransfer.csproj" />
        -->
        <PackageReference Include="ArgusTransfer" />

    </ItemGroup>

    <ItemGroup>
        <!-- The Worker SDK includes appsettings*.json as Content, so a None item would not match -->
        <Content Update="appsettings.Development.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
    </ItemGroup>
</Project>