{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/argus-health-service-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ArgusHealth": {
    "PipeName": "ArgusHealth",
    "DatabaseFileName": "ArgusHealth.sqlite"
  }
}
