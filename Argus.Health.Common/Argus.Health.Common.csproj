<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
      <Version>0.1.0</Version>
      <LangVersion>13.0</LangVersion>
    <Copyright>Copyright © Sam Gerené</Copyright>
      <AssemblyTitle>Argus.Health.Common</AssemblyTitle>
      <Title>Argus Health Common</Title>
      <Description>A background service that queries health endpoints.</Description>
      <RequireLicenseAcceptance>true</RequireLicenseAcceptance>
      <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
      <IncludeSource>true</IncludeSource>
      <IncludeSymbols>true</IncludeSymbols>
      <RepositoryUrl>https://github.com/samgerene/Argus.Health.git</RepositoryUrl>
      <RepositoryType>Git</RepositoryType>
      <NeutralLanguage>en-US</NeutralLanguage>
      <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
      <Authors>Sam Gerené</Authors>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageIcon>argus-health.png</PackageIcon>
      <PackageTags>Health status</PackageTags>
      <PackageReleaseNotes>
          [Initial] Version
      </PackageReleaseNotes>
      <Nullable>enable</Nullable>
      <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
