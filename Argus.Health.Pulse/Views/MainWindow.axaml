<reactiveui:ReactiveWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Argus.Health.Pulse.ViewModels"
        xmlns:views="using:Argus.Health.Pulse.Views"
        xmlns:reactiveui="using:ReactiveUI.Avalonia"
        x:TypeArguments="vm:MainWindowViewModel"
        x:Class="Argus.Health.Pulse.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1024" Height="680"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

    <Panel>
        <DockPanel>
            <!-- Sidebar -->
            <DockPanel DockPanel.Dock="Left" Width="180" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Margin="0,32,0,0">
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <TextBlock Text="Argus Health Pulse" FontWeight="Bold" FontSize="14" Margin="12,8,12,16" />
                    <Button x:Name="DashboardButton" Content="Dashboard" HorizontalAlignment="Stretch" Margin="8,0" />
                    <Button x:Name="EndpointsButton" Content="Endpoints" HorizontalAlignment="Stretch" Margin="8,0" />

                    <!-- Connection status indicators -->
                    <Border x:Name="ConnectingBorder" Background="#FF9800" CornerRadius="4" Margin="8,16,8,0" Padding="8,6">
                        <TextBlock Text="Connecting..." Foreground="White" FontSize="12"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </Border>

                    <Border x:Name="ConnectedBorder" Background="#4CAF50" CornerRadius="4" Margin="8,16,8,0" Padding="8,6">
                        <TextBlock Text="Service connected" Foreground="White" FontSize="12"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </Border>

                    <Border x:Name="DegradedBorder" Background="#FF9800" CornerRadius="4" Margin="8,16,8,0" Padding="8,6">
                        <TextBlock Text="Connection unstable" Foreground="White" FontSize="12"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </Border>

                    <Border x:Name="ErrorBorder" Background="#D32F2F" CornerRadius="4" Margin="8,16,8,0" Padding="8,6">
                        <TextBlock Text="Service unavailable" Foreground="White" FontSize="12"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </Border>

                    <!-- Sync toggle button -->
                    <Button x:Name="SyncButton"
                            HorizontalAlignment="Stretch" Margin="8,8" />
                </StackPanel>

                <Button x:Name="AboutButton" Content="About" DockPanel.Dock="Bottom"
                        HorizontalAlignment="Stretch" Margin="8,0,8,8" VerticalAlignment="Bottom" />
            </DockPanel>

            <!-- Content area -->
            <DockPanel>
                <ProgressBar x:Name="SyncProgressBar" DockPanel.Dock="Top"
                             Minimum="0" Maximum="100"
                             Height="3"
                             Margin="16,40,16,0"
                             Foreground="#4CAF50"
                             Classes.connectionError="{Binding IsConnectionError}">
                    <ProgressBar.Styles>
                        <Style Selector="ProgressBar.connectionError">
                            <Setter Property="Foreground" Value="#9E9E9E" />
                        </Style>
                    </ProgressBar.Styles>
                </ProgressBar>
                <reactiveui:ViewModelViewHost x:Name="ContentHost" Margin="16" />
            </DockPanel>
        </DockPanel>

        <!-- Toast notification overlay -->
        <views:NotificationOverlay x:Name="NotificationOverlayControl"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,16,16" />
    </Panel>

</reactiveui:ReactiveWindow>
