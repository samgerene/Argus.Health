<reactiveui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.Health.Pulse.ViewModels"
             xmlns:model="using:Argus.Health.Common.Model"
             xmlns:controls="using:Argus.Health.Pulse.Controls"
             xmlns:reactiveui="using:ReactiveUI.Avalonia"
             x:TypeArguments="vm:DashboardViewModel"
             x:Class="Argus.Health.Pulse.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <DockPanel>
        <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,12" />

        <!-- Summary cards -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <!-- Total Endpoints -->
            <Border Background="#1e293b" CornerRadius="8" Padding="16,12" MinWidth="140"
                    ToolTip.Tip="Total number of health endpoints being monitored">
                <StackPanel Spacing="4">
                    <TextBlock Text="Endpoints" FontSize="11" Foreground="#94a3b8" />
                    <TextBlock x:Name="TotalEndpointsText" FontSize="24" FontWeight="Bold" Foreground="#2dd4bf" />
                </StackPanel>
            </Border>

            <!-- Uptime % -->
            <Border Background="#1e293b" CornerRadius="8" Padding="16,12" MinWidth="140"
                    ToolTip.Tip="Percentage of successful health checks across all endpoints in the last 24 hours">
                <StackPanel Spacing="4">
                    <TextBlock Text="Uptime (24h)" FontSize="11" Foreground="#94a3b8" />
                    <TextBlock x:Name="UptimePercentText" FontSize="24" FontWeight="Bold" Foreground="#22c55e" />
                </StackPanel>
            </Border>

            <!-- Avg Response Time -->
            <Border Background="#1e293b" CornerRadius="8" Padding="16,12" MinWidth="140"
                    ToolTip.Tip="Average response time of the most recent health check across all endpoints">
                <StackPanel Spacing="4">
                    <TextBlock Text="Avg Response" FontSize="11" Foreground="#94a3b8" />
                    <TextBlock x:Name="AvgResponseTimeText" FontSize="24" FontWeight="Bold" Foreground="#2dd4bf" />
                </StackPanel>
            </Border>

            <!-- Currently Down (clickable) -->
            <Button x:Name="DownCardButton" Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand"
                    ToolTip.Tip="Click to filter endpoints to those currently down">
                <Border x:Name="DownCardBorder" Background="#1e293b" CornerRadius="8" Padding="16,12" MinWidth="140">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Down" FontSize="11" Foreground="#94a3b8" />
                        <TextBlock x:Name="EndpointsDownText" FontSize="24" FontWeight="Bold" Foreground="#ef4444" />
                    </StackPanel>
                </Border>
            </Button>

            <!-- Incidents 24h (clickable) -->
            <Button x:Name="IncidentsCardButton" Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand"
                    ToolTip.Tip="Click to view failed health checks in the last 24 hours">
                <Border x:Name="IncidentsCardBorder" Background="#1e293b" CornerRadius="8" Padding="16,12" MinWidth="140">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Incidents (24h)" FontSize="11" Foreground="#94a3b8" />
                        <TextBlock x:Name="IncidentsText" FontSize="24" FontWeight="Bold" Foreground="#f59e0b" />
                    </StackPanel>
                </Border>
            </Button>
        </StackPanel>

        <!-- View toggle -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
            <Button x:Name="ShowEndpointsButton" Content="Endpoints" Padding="12,4" FontSize="12" />
            <Button x:Name="ShowIncidentsButton" Content="Incidents" Padding="12,4" FontSize="12" />
            <Border Width="1" Background="#334155" Margin="8,2" />
            <Button x:Name="ShowActiveButton" Content="Active" Padding="12,4" FontSize="12" />
            <Button x:Name="ShowInactiveButton" Content="Inactive" Padding="12,4" FontSize="12" />
            <Button x:Name="ShowAllActivityButton" Content="All" Padding="12,4" FontSize="12" />
        </StackPanel>

        <!-- Detail panel (bottom, shown when an endpoint is selected) -->
        <Border x:Name="DetailPanel" DockPanel.Dock="Bottom"
                Background="#1e293b" CornerRadius="8" Padding="16" Margin="0,12,0,0"
                Height="340">
            <Grid RowDefinitions="*,4,*">
                <!-- Top row: Response Time Chart (full width) -->
                <Border Grid.Row="0" Background="#253347" CornerRadius="6" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                            <TextBlock Text="Response Time" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="LastHourButton" Content="1h" Padding="8,2" FontSize="11"
                                    ToolTip.Tip="Show the last hour" />
                            <Button x:Name="Last6HoursButton" Content="6h" Padding="8,2" FontSize="11"
                                    ToolTip.Tip="Show the last 6 hours" />
                            <Button x:Name="Last24HoursButton" Content="24h" Padding="8,2" FontSize="11"
                                    ToolTip.Tip="Show the last 24 hours" />
                            <Button x:Name="Last7DaysButton" Content="7d" Padding="8,2" FontSize="11"
                                    ToolTip.Tip="Show the last 7 days" />
                            <Button x:Name="Last30DaysButton" Content="30d" Padding="8,2" FontSize="11"
                                    ToolTip.Tip="Show the last 30 days" />
                        </StackPanel>
                        <controls:ResponseTimeChartControl x:Name="ResponseTimeChart"
                            ToolTip.Tip="Response time in milliseconds over the selected time range. Red dots indicate failed checks." />
                    </DockPanel>
                </Border>

                <!-- Bottom row: Uptime Visualization + Stats -->
                <Border Grid.Row="2" Background="#253347" CornerRadius="6" Padding="12">
                    <Grid ColumnDefinitions="2*,*">
                        <!-- Uptime Visualization -->
                        <DockPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                <TextBlock x:Name="UptimeLabelText" Text="Uptime (90d)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button x:Name="Uptime7DaysButton" Content="7d" Padding="8,2" FontSize="11"
                                        ToolTip.Tip="Show uptime for the last 7 days" />
                                <Button x:Name="Uptime30DaysButton" Content="30d" Padding="8,2" FontSize="11"
                                        ToolTip.Tip="Show uptime for the last 30 days" />
                                <Button x:Name="Uptime60DaysButton" Content="60d" Padding="8,2" FontSize="11"
                                        ToolTip.Tip="Show uptime for the last 60 days" />
                                <Button x:Name="Uptime90DaysButton" Content="90d" Padding="8,2" FontSize="11"
                                        ToolTip.Tip="Show uptime for the last 90 days" />
                                <Border Width="1" Background="#334155" Margin="8,2" />
                                <Button x:Name="StatusBarViewButton" Content="Status Bar" Padding="8,2" FontSize="11"
                                        ToolTip.Tip="Show uptime as a segmented status bar" />
                                <Button x:Name="HeatmapViewButton" Content="Heatmap" Padding="8,2" FontSize="11"
                                        ToolTip.Tip="Show uptime as a daily heatmap grid" />
                            </StackPanel>
                            <Panel>
                                <controls:UptimeStatusBarControl x:Name="UptimeStatusBar"
                                    ToolTip.Tip="Uptime status bar: green = 100% healthy, amber = degraded, red = down, gray = no data" />
                                <controls:UptimeHeatmapControl x:Name="UptimeHeatmap"
                                    ToolTip.Tip="Daily uptime heatmap: color intensity reflects uptime percentage per day" />
                            </Panel>
                        </DockPanel>

                        <!-- Stats Summary -->
                        <DockPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Statistics" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            ToolTip.Tip="Current HTTP status of the endpoint">
                                    <TextBlock Text="Status:" Foreground="#94a3b8" Width="80" />
                                    <TextBlock x:Name="CurrentStatusText" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            ToolTip.Tip="Percentage of successful checks in the selected time range">
                                    <TextBlock Text="Uptime:" Foreground="#94a3b8" Width="80" />
                                    <TextBlock x:Name="DetailUptimeText" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            ToolTip.Tip="Average response time in the selected time range">
                                    <TextBlock Text="Avg:" Foreground="#94a3b8" Width="80" />
                                    <TextBlock x:Name="DetailAvgText" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            ToolTip.Tip="95th percentile response time: 95% of checks were faster than this value">
                                    <TextBlock Text="P95:" Foreground="#94a3b8" Width="80" />
                                    <TextBlock x:Name="DetailP95Text" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            ToolTip.Tip="Slowest response time in the selected time range">
                                    <TextBlock Text="Max:" Foreground="#94a3b8" Width="80" />
                                    <TextBlock x:Name="DetailMaxText" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            ToolTip.Tip="Total number of health checks performed in the selected time range">
                                    <TextBlock Text="Checks:" Foreground="#94a3b8" Width="80" />
                                    <TextBlock x:Name="DetailTotalChecksText" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            ToolTip.Tip="Number of checks that returned a non-successful status code">
                                    <TextBlock Text="Failures:" Foreground="#94a3b8" Width="80" />
                                    <TextBlock x:Name="DetailFailuresText" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Endpoints DataGrid -->
        <DataGrid x:Name="EndpointsGrid"
                  ItemsSource="{Binding FilteredEndpoints}"
                  SelectedItem="{ReflectionBinding SelectedEndpoint}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:EndpointStatusViewModel">
                            <controls:StatusDotControl IsHealthy="{Binding IsHealthy}" StatusCode="{Binding StatusCode}"
                                                       Width="12" Height="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       ToolTip.Tip="Health status: green = healthy (2xx), red = error, gray = pending" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{ReflectionBinding Name}" Width="180" SortMemberPath="Name" />
                <DataGridTextColumn Header="URL" Binding="{ReflectionBinding Url}" Width="250" SortMemberPath="Url" />
                <DataGridTemplateColumn Header="Trend" Width="120" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:EndpointStatusViewModel">
                            <controls:SparklineControl Data="{Binding RecentResponseTimes}"
                                                        Height="24" Margin="4,2"
                                                        ToolTip.Tip="Response time trend for the last 20 health checks" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{ReflectionBinding StatusDisplay}" Width="100" SortMemberPath="StatusCode" />
                <DataGridTextColumn Header="Response" Binding="{ReflectionBinding ResponseTimeMs, StringFormat='{}{0}ms'}" Width="80" SortMemberPath="ResponseTimeMs" />
                <DataGridTextColumn Header="Last Checked" Binding="{ReflectionBinding LastChecked, StringFormat='{}{0:HH:mm:ss}'}" Width="100" SortMemberPath="LastChecked" />
                <DataGridTextColumn Header="Error" Binding="{ReflectionBinding ErrorMessage}" Width="*" SortMemberPath="ErrorMessage" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Incidents DataGrid -->
        <DataGrid x:Name="IncidentsGrid"
                  ItemsSource="{Binding IncidentResults}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="False"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Endpoint" Binding="{ReflectionBinding EndpointName}" Width="180" />
                <DataGridTextColumn Header="Time" Binding="{ReflectionBinding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160" />
                <DataGridTextColumn Header="Status" Binding="{ReflectionBinding StatusCode}" Width="80" />
                <DataGridTextColumn Header="Response" Binding="{ReflectionBinding ResponseTimeMs, StringFormat='{}{0}ms'}" Width="80" />
                <DataGridTextColumn Header="Error" Binding="{ReflectionBinding ErrorMessage}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

</reactiveui:ReactiveUserControl>
