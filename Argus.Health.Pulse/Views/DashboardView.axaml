<reactiveui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.Health.Pulse.ViewModels"
             xmlns:reactiveui="using:ReactiveUI.Avalonia"
             x:TypeArguments="vm:DashboardViewModel"
             x:Class="Argus.Health.Pulse.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <DockPanel>
        <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,16" />

        <DataGrid x:Name="EndpointsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="300" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="120" />
                <DataGridTextColumn Header="Last Checked" Binding="{Binding LastChecked, StringFormat='{}{0:HH:mm:ss}'}" Width="120" />
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

</reactiveui:ReactiveUserControl>
