<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.Health.Pulse.ViewModels"
             x:Class="Argus.Health.Pulse.Views.EndpointEditorView"
             x:DataType="vm:EndpointEditorViewModel">

    <StackPanel Spacing="12" MaxWidth="500" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

        <!-- Error message -->
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel Spacing="4">
            <TextBlock Text="Name" />
            <TextBox Text="{Binding Name}" Watermark="e.g. Production API" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="URL" />
            <TextBox Text="{Binding Url}" Watermark="https://example.com/health" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Frequency (seconds)" />
            <NumericUpDown Value="{Binding Frequency}" Minimum="1" Maximum="3600" Increment="1" FormatString="0" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Timeout (seconds)" />
            <NumericUpDown Value="{Binding Timeout}" Minimum="1" Maximum="300" Increment="1" FormatString="0" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Retry Count" />
            <NumericUpDown Value="{Binding RetryCount}" Minimum="1" Maximum="10" Increment="1" FormatString="0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>

</UserControl>
