<reactiveui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.Health.Pulse.ViewModels"
             xmlns:reactiveui="using:ReactiveUI.Avalonia"
             x:TypeArguments="vm:EndpointEditorViewModel"
             x:Class="Argus.Health.Pulse.Views.EndpointEditorView"
             x:DataType="vm:EndpointEditorViewModel">

    <StackPanel Spacing="12" MaxWidth="500" HorizontalAlignment="Left">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

        <!-- Error message -->
        <TextBlock x:Name="ErrorMessageText" Foreground="Red" />

        <StackPanel Spacing="4">
            <TextBlock Text="Name" />
            <TextBox x:Name="NameTextBox" PlaceholderText="e.g. Production API" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="URL" />
            <TextBox x:Name="UrlTextBox" PlaceholderText="https://example.com/health" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Frequency (seconds)" />
            <NumericUpDown x:Name="FrequencyUpDown" Minimum="1" Maximum="3600" Increment="1" FormatString="0" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Timeout (seconds)" />
            <NumericUpDown x:Name="TimeoutUpDown" Minimum="1" Maximum="300" Increment="1" FormatString="0" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Retry Count" />
            <NumericUpDown x:Name="RetryCountUpDown" Minimum="1" Maximum="10" Increment="1" FormatString="0" />
        </StackPanel>

        <CheckBox x:Name="IsActiveCheckBox" Content="Active" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save" Classes="accent" />
            <Button x:Name="CancelButton" Content="Cancel" />
        </StackPanel>
    </StackPanel>

</reactiveui:ReactiveUserControl>
