<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.Health.Pulse.ViewModels"
             xmlns:model="using:Argus.Health.Common.Model"
             x:Class="Argus.Health.Pulse.Views.EndpointListView"
             x:DataType="vm:EndpointListViewModel">

    <Panel>
        <DockPanel>
            <TextBlock Text="Endpoints" FontSize="20" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8" />

            <!-- Toolbar -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <Button Content="Add" Command="{Binding AddCommand}" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            </StackPanel>

            <!-- Error message -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" DockPanel.Dock="Top"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Margin="0,0,0,8" />

            <!-- Empty state -->
            <TextBlock Text="No endpoints defined yet. Click 'Add' to create one."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" FontSize="14"
                       IsVisible="{Binding !HasEndpoints}"
                       DockPanel.Dock="Top" Margin="0,24,0,0" />

            <!-- Endpoint list -->
            <DataGrid ItemsSource="{Binding Endpoints}"
                      SelectedItem="{Binding SelectedEndpoint}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      IsVisible="{Binding HasEndpoints}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="300" />
                    <DataGridTextColumn Header="Frequency (s)" Binding="{Binding Frequency}" Width="100" />
                    <DataGridTextColumn Header="Timeout (s)" Binding="{Binding Timeout}" Width="100" />
                    <DataGridTextColumn Header="Retries" Binding="{Binding RetryCount}" Width="80" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                    <DataGridTemplateColumn Header="Actions" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="model:HealthEndPoint">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="Edit"
                                            Command="{Binding $parent[DataGrid].((vm:EndpointListViewModel)DataContext).EditCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Delete"
                                            Command="{Binding $parent[DataGrid].((vm:EndpointListViewModel)DataContext).DeleteCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Delete confirmation overlay -->
        <Border Background="#80000000" IsVisible="{Binding IsDeleteConfirmationVisible}">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="400">
                <StackPanel Spacing="16">
                    <TextBlock Text="Confirm Delete" FontSize="18" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Are you sure you want to delete endpoint '" /><Run Text="{Binding PendingDeleteEndpoint.Name}" /><Run Text="'?" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
                        <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" Classes="danger" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>

</UserControl>
