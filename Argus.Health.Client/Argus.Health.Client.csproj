<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0</Version>
    <LangVersion>14.0</LangVersion>
    <Copyright>Copyright © Sam Gerené</Copyright>
    <AssemblyTitle>Argus.Health.Client</AssemblyTitle>
    <Title>Argus Health Client</Title>
    <Description>A client library for the Argus Health named-pipe IPC protocol.</Description>
    <RequireLicenseAcceptance>true</RequireLicenseAcceptance>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IncludeSource>true</IncludeSource>
    <IncludeSymbols>true</IncludeSymbols>
    <RepositoryUrl>https://github.com/samgerene/Argus.Health.git</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <Authors>Sam Gerené</Authors>
    <PackageTags>Health status</PackageTags>
    <PackageReleaseNotes>
        [Initial] Version
    </PackageReleaseNotes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Argus.Health.Common\Argus.Health.Common.csproj" />
    <ProjectReference Include="..\..\ArgusTransfer\ArgusTransfer\ArgusTransfer.csproj" />
  </ItemGroup>

</Project>
