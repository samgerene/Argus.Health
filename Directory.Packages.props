<Project>

  <!--
    The versions of all NuGet packages of the solution (NuGet Central Package Management).
    A project file references a package without a version: <PackageReference Include="..." />.
    A new package needs a PackageVersion entry here.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- ArgusTransfer. Its Microsoft.Extensions dependencies set the minimum for the group below. -->
  <ItemGroup>
    <PackageVersion Include="ArgusTransfer" Version="1.3.0" />
  </ItemGroup>

  <!-- Microsoft.Extensions and the other packages of the .NET release: update them together -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <!-- Avalonia: update together. Avalonia.Diagnostics is referenced in Debug only and has its own version line. -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless.NUnit" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <!--
    ReactiveUI: PINNED, do not update as part of a routine dependency update.
    ReactiveUI 24 and later are built on ReactiveUI.Primitives and no longer bring System.Reactive and
    DynamicData, which Pulse uses; ReactiveUI.Avalonia 12.1.0 and later require ReactiveUI 24 or later.
    The migration is issue 27.
  -->
  <ItemGroup>
    <PackageVersion Include="ReactiveUI" Version="23.2.28" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.0.3" />
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="2.6.30" />
  </ItemGroup>

  <!-- Serilog -->
  <ItemGroup>
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Other -->
  <ItemGroup>
    <PackageVersion Include="FluentResults" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <!-- Test tooling -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Console" Version="3.22.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <!--
    WiX: PINNED. The version must equal the WixToolset.Sdk version in the Sdk attribute of
    Argus.Health.Installer.wixproj. WiX 6 and later do not build until the Open Source Maintenance Fee
    EULA is accepted (error WIX7015).
  -->
  <ItemGroup>
    <PackageVersion Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
